# ELHGS Production Environment Variables Template
PROJECT_NAME="Explainable Livestock Health Grading System"
VERSION="1.0.0"

# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=elhgs_production_db
POSTGRES_USER=elhgs_admin
POSTGRES_PASSWORD=STRONG_PRODUCTION_PASSWORD_HERE

# Application Security
SECRET_KEY=GENERATE_RANDOM_256BIT_SECRET_KEY_HERE
DEBUG=False
DEMO_MODE=False

# CORS Origins (Comma separated)
CORS_ORIGINS="https://elhgs.vercel.app,https://your-domain.com"

# Sentry Monitoring (Optional)
SENTRY_DSN=""
